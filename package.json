{
  "name": "lumaspinner",
  "version": "1.0.0",
  "description": "Zero-dependency, accessible loading UI library with 30+ spinners, skeletons, progress gauges, 3D perspective loaders, and interactive mini-games for the modern web.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite playground --host",
    "build": "node scripts/sync-css.cjs && tsup",
    "build:watch": "tsup --watch",
    "build:playground": "vite build playground --outDir ../dist-playground --emptyOutDir",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "spinner",
    "loader",
    "loading",
    "spinners",
    "loaders",
    "loading-spinner",
    "react-spinner",
    "skeleton",
    "skeleton-loader",
    "shimmer",
    "progress",
    "progress-bar",
    "progress-ring",
    "3d-spinner",
    "interactive-loader",
    "zero-dependencies",
    "framework-agnostic",
    "typescript",
    "accessible",
    "a11y",
    "animation",
    "css3-animations",
    "page-loader",
    "container-loader",
    "inline-loader",
    "fidget-spinner",
    "spinkit",
    "web"
  ],
  "author": "Krishna Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mekrishnaa/lumaSpinner.git"
  },
  "bugs": {
    "url": "https://github.com/mekrishnaa/lumaSpinner/issues"
  },
  "homepage": "https://github.com/mekrishnaa/lumaSpinner#readme",
  "sideEffects": ["*.css", "./dist/styles.css"],
  "engines": { "node": ">=18.0.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "jsdom": "^25.0.0",
    "@vitest/coverage-v8": "^3.2.7"
  }
}

